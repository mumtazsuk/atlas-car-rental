# =====================================================================
# ATLAS CAR RENTAL & SAAS PLATFORM — ENVIRONMENT CONFIGURATION
# =====================================================================

# 1. Supabase PostgreSQL & Auth (Required for Live Database Mode)
# If left blank, the application seamlessly runs in Demo/Local Store Mode
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# 2. Application & Branding
NEXT_PUBLIC_APP_NAME=Atlas Car Rental
NEXT_PUBLIC_APP_URL=http://localhost:3000

# 3. Stripe Subscription & Payment Billing (Optional / SaaS Edition)
STRIPE_SECRET_KEY=sk_test_placeholder_key
STRIPE_WEBHOOK_SECRET=whsec_placeholder_secret
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_placeholder_key

# 4. Transactional Email Provider (Resend / SendGrid / Postmark - Optional)
EMAIL_PROVIDER_API_KEY=re_placeholder_email_api_key
EMAIL_FROM_ADDRESS=notifications@atlasrental.com

# 5. GPS Vehicle Telemetry Integration (Wialon / Traccar / Simulator)
WIALON_API_BASE_URL=https://hst-api.wialon.com/wialon/ajax.html
WIALON_API_TOKEN=placeholder_wialon_token

# 6. Scheduled Serverless Jobs Authentication
CRON_SECRET=atlas_secure_cron_secret_key_32bytes
